# FIREBASE_CONFIG: Required for Firebase initialization.
# These are public web-app config values (not secrets); Vite inlines them
# into the bundle at build time. In Cloud Run deploys they are supplied as
# Docker --build-arg values (see cloudbuild.yaml).
VITE_FIREBASE_API_KEY="YOUR_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_APP_ID"

# ADMIN_EMAIL: The email address of the administrator.
VITE_ADMIN_EMAIL="admin@example.com"
